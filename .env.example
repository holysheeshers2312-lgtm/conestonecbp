# ============================================
# ConeStone CBP — bookings + WhatsApp + Admin
# ============================================

# Public site URL (used in WhatsApp status links)
NEXT_PUBLIC_SITE_URL=https://conestonecbp.com

# --- Required: Neon Postgres ---
# Create a free DB at https://neon.tech → copy connection string
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Soft daily cover cap (temporary default 40)
SOFT_DAILY_COVER_CAP=40

# --- Admin (two staff PINs) ---
ADMIN_PIN_MADHAV=1234
ADMIN_PIN_SOUJANYA=5678
ADMIN_SESSION_SECRET=long-random-string

# --- OpenWA WhatsApp (https://www.open-wa.org) ---
# Self-host OpenWA, scan QR, OPERATOR API key + session UUID
OPENWA_BASE_URL=http://127.0.0.1:2785
OPENWA_API_KEY=owa_k1_xxxxxxxx
OPENWA_SESSION_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
OPENWA_NOTIFY_PHONE=6581725039

# --- Optional email backup for staff ---
# RESEND_API_KEY=re_xxxxxxxx
# RESERVATION_TO_EMAIL=contact@conestonecbp.com
# RESEND_FROM_EMAIL="ConeStone CBP <bookings@conestonecbp.com>"
# WEB3FORMS_ACCESS_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
